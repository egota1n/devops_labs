{
  "name": "server",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "NODE_ENV=test jest --forceExit --detectOpenHandles",
    "test:ci": "NODE_ENV=test jest --ci --coverage --coverageReporters=lcov",
    "test:coverage": "NODE_ENV=test jest --coverage --coverageReporters=lcov"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "mongoose": "^7.4.1",
    "morgan": "^1.10.0",
    "node-telegram-bot-api": "^0.66.0",
    "prom-client": "^15.1.3",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "jest": "^29.6.1",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "**/*.js",
      "!**/node_modules/**",
      "!**/coverage/**"
    ]
  }
}
